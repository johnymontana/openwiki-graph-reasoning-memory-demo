# Direct AuraDB connection used by the trace ingester.
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-me
NEO4J_DATABASE=neo4j
# Optional name of a stored neo4j-cli DBMS credential for the shell helpers.
# NEO4J_CREDENTIAL=reasoning-aura

# Remote MCP endpoint copied from the external Aura Agent.
AURA_AGENT_MCP_URL=https://mcp.neo4j.io/agent?project_id=...&agent_id=...
# Prefer machine-to-machine credentials created for "Aura Agent & MCP".
AURA_AGENT_MCP_CLIENT_ID=replace-me
AURA_AGENT_MCP_CLIENT_SECRET=replace-me
# Optional override: a pre-minted short-lived bearer token.
# AURA_AGENT_MCP_ACCESS_TOKEN=
# Optional when tools/list returns more than one tool.
AURA_AGENT_MCP_TOOL=

# Instrumented runs and the recall evaluation (run/evaluate commands).
# Path to the built OpenWiki fork; defaults to ../openwiki next to this repo.
# OPENWIKI_DIR=../openwiki
# Anthropic key for headless OpenWiki runs (provider is pinned to anthropic).
ANTHROPIC_API_KEY=replace-me
# Optional model override; OpenWiki's anthropic default is claude-haiku-4-5.
# OPENWIKI_MODEL_ID=claude-haiku-4-5
